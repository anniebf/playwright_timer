# =====================================================================
# .env.example - modelo das variáveis de ambiente do Protheus Timer
# Copie para ".env" (mesma pasta do main_playwright.py) e preencha.
# NUNCA versione o .env: ele tem senhas. Ele já está no .gitignore.
# Explicação de cada variável no README (seção 4.3).
# =====================================================================

# ---------- Protheus: parâmetros iniciais e empresa/filial ----------
# Programa inicial do WebApp (o menu SIGAADV junta as rotinas de vários módulos)
Setup_rotina=SIGAADV
# Ambiente do AppServer (se vazio, usa "Environment" do config.json)
Setup_ambiente=bf
# Grupo de empresas e filial da tela de empresa/filial.
# Sem Setup_emp, essa tela é pulada.
Setup_emp=01
Setup_filial=0101001

# ---------- MFA: leitura do código no e-mail (Microsoft Graph) ----------
# Aplicativo do Azure AD com permissão de APLICAÇÃO Mail.Read (consentimento de admin)
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=TROQUE_PELO_SEGREDO
# Caixa de e-mail que recebe o código MFA do usuário do RPA
BOT_USER_EMAIL=caixa.mfa@suaempresa.com.br
# Pasta onde o código chega: "inbox" ou o ID de uma pasta do Outlook
FOLDER_ID=inbox

# ---------- Oracle: tabela RPA.TIMER (tempos, logs e mapa de calor) ----------
usernamedb=usuario_oracle
passworddb=TROQUE_PELA_SENHA
# host:porta/service_name
dsn=servidor-oracle:1521/NOME_DO_SERVICO
# Valor gravado na coluna USUARIO do RPA.TIMER
usuario=bf.rpa01

# ---------- SMTP: e-mails de alerta (erro, base fora, licença, lentidão) ----------
server_smtp=smtp.office365.com
port=587
sender_mail=robo@suaempresa.com.br
password=TROQUE_PELA_SENHA
